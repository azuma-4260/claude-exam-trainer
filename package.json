{
  "name": "claude-exam-trainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "validate-bank": "tsx scripts/validate-bank.ts",
    "audit:flash": "tsx scripts/audit-flash.ts --status active",
    "audit:form": "tsx scripts/audit-form-mcq.ts --status active",
    "audit:practice": "tsx scripts/audit-practice-mcq.ts --counts 19,13,14,14,10 --status active",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx scripts/db-check.ts",
    "task:check": "tsx scripts/task/check.ts",
    "task:start": "tsx scripts/task/start.ts",
    "task:report": "tsx scripts/task/report.ts",
    "backlog:check": "tsx scripts/backlog/check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "5.4.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
